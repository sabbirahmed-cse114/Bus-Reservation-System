@model CityCreateModel

<h1>Create</h1>
<div class="row">
    <form asp-antiforgery="true" asp-area="" asp-controller="City"
          asp-action="Create" method="post" id="create-form">
        <div class="form-group">
            <input asp-for="Name" type="text" class="form-control" id="name" name="name" placeholder="Name">
        </div>
            <button type="button" id="modal_close" class="btn btn-sm btn-danger px-3" data-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-sm btn-info px-3">Submit</button>
    </form>
</div>

